///|
pub fn get_logo_color(dim : Int, col : Int, row : Int) -> @color.Color? {
  if col < 0 || col >= dim || row < 0 || row >= dim {
    return None
  }
  let c128 = col * 128 / dim
  let r128 = row * 128 / dim
  let idx = r128 * 128 + c128
  if idx < 0 || idx >= logo_grid_128.length() {
    return None
  }
  let val = logo_grid_128[idx]
  if (val & 0xFF000000) == 0 {
    None
  } else {
    let r = (val >> 16) & 0xFF
    let g = (val >> 8) & 0xFF
    let b = val & 0xFF
    Some(@color.Color::rgb(r, g, b))
  }
}
