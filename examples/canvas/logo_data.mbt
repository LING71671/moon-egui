///|
pub fn get_logo_color(size : Int, index : Int) -> @color.Color? {
  let code = match size {
    12 =>
      if index >= 0 && index < logo_grid_12.length() {
        logo_grid_12[index]
      } else {
        0
      }
    20 =>
      if index >= 0 && index < logo_grid_20.length() {
        logo_grid_20[index]
      } else {
        0
      }
    32 =>
      if index >= 0 && index < logo_grid_32.length() {
        logo_grid_32[index]
      } else {
        0
      }
    40 =>
      if index >= 0 && index < logo_grid_40.length() {
        logo_grid_40[index]
      } else {
        0
      }
    _ => 0
  }
  if code == 0 {
    None
  } else {
    let r = (code >> 16) & 0xFF
    let g = (code >> 8) & 0xFF
    let b = code & 0xFF
    Some(@color.Color::rgb(r, g, b))
  }
}
